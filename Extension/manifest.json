{
  "manifest_version": 3,
  "name": "T3 Notch",
  "version": "1.0.0",
  "description": "Lets T3 Notch select page elements, not only screen boxes, when you clip a browser window.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "T3 Notch" },
  "icons": { "128": "icon128.png" }
}
